# Eden Falls Resort — environment configuration
# Copy to `.env` (never commit it). Both apps read this single file:
#   - the API loads it via `node --env-file`
#   - Vite reads it via envDir and exposes ONLY variables prefixed with VITE_
#
# Local values for the Supabase CLI stack come from `npm run db:status`.

# ---------------------------------------------------------------- Frontend (public)
# Base URL of the API as seen by the browser. Leave as /api in development (Vite proxies it).
VITE_API_BASE_URL=/api
# Supabase project URL and *publishable* key (sb_publishable_…, or the legacy anon key).
# These are safe to expose; RLS keeps private data private.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Canonical public URL of the website (used for SEO tags and the sitemap).
VITE_SITE_URL=http://localhost:5173

# ---------------------------------------------------------------- API (server only)
PORT=4000
NODE_ENV=development
# LOG_LEVEL=info
# Comma-separated browser origins allowed by CORS.
FRONTEND_URL=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173
# Number of reverse proxies in front of the API (0 when exposed directly, 1 behind Nginx).
TRUST_PROXY=0

SUPABASE_URL=http://127.0.0.1:54321
# Server-only secret key (sb_secret_…). NEVER expose to the browser or commit it.
# The legacy service_role JWT also works via SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Optional extra gate: only these emails may use /api/admin (comma-separated).
ADMIN_EMAIL_ALLOWLIST=
# Random secret (>= 32 chars) for guest confirmation links. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BOOKING_LOOKUP_SECRET=replace-with-a-long-random-secret-of-32-chars-or-more

# Optional: staff email alerts via Resend. Leave blank to disable.
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=
